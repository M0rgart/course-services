APP__TITLE=Course service
APP__DESCRIPTION=REST API for courses and assignments
APP__SUMMARY=Course service API
APP__VERSION=1.0.0

DB__URL=sqlite+aiosqlite:///./course.db
DB__ECHO=false

JWT__SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
JWT__ALGORITHM=HS256
JWT__ISSUER=course-service
JWT__AUDIENCE=course-service-clients
JWT__LEEWAY=5

SECURITY__BODY_LIMIT_BYTES=1048576

EXTERNAL__TIMEOUT_SECONDS=2.0
EXTERNAL__MAX_CONCURRENCY=5
EXTERNAL__SIMULATION_DELAY_SECONDS=0.1
